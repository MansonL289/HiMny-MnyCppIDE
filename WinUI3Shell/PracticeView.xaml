                    Height="30"
                    Padding="12,0"
                    CornerRadius="8"
                    FontSize="12"
                    Content="翻译"
                    Visibility="Collapsed"
                    Click="TranslateButton_Click" />
                <Button
                    Grid.Column="4"
                    Height="30"
                    Padding="12,0"
                    CornerRadius="8"
                    FontSize="12"
                    Content="打开原题"
                    Click="OpenOriginal_Click" />
            </Grid>

            <Grid Grid.Row="1" Margin="16,0,16,16" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左：题面（Markdown + LaTeX） -->
                <Border
                    Grid.Column="0"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <WebView2 x:Name="ProblemWebView" />
                </Border>

                <!-- 右：草稿编辑器 + 操作 -->
                <Grid Grid.Column="1" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            x:Name="LanguageCombo"
                            Grid.Column="0"
                            Height="30"
                            MinWidth="120"
                            FontSize="12"
                            CornerRadius="8"
                            SelectionChanged="LanguageCombo_SelectionChanged">
                            <ComboBoxItem Content="C++17" Tag="cpp" IsSelected="True" />
                        </ComboBox>
                    </Grid>

                    <Border
                        Grid.Row="1"
                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <WebView2 x:Name="PracticeEditorWebView" />
                    </Border>

                    <!-- 底部操作栏 -->
                    <StackPanel
                        Grid.Row="2"
                        Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Right">
                        <Button
                            Height="32"
                            Padding="16,0"
                            CornerRadius="8"
                            FontSize="12"
                            Content="重置草稿"
                            Click="ResetDraft_Click" />
                        <Button
                            Height="32"
                            Padding="16,0"
                            CornerRadius="8"
                            FontSize="12"
                            Content="提交"
                            Click="Submit_Click"
                            AutomationProperties.AutomationId="PracticeSubmitButton" />
                        <Button
                            Height="32"
                            Padding="16,0"
                            CornerRadius="8"
                            FontSize="12"
                            Content="测试"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="TestSample_Click"
                            AutomationProperties.AutomationId="PracticeTestButton" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- 洛谷官方筛选面板：分类标签 + 难度 -->
        <Grid
            x:Name="LuoguFilterOverlay"
            Background="#66000000"
            Visibility="Collapsed"
            AutomationProperties.AutomationId="LuoguFilterOverlay">
            <Border
                Width="720"
                MaxHeight="640"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 标题 -->
                    <Grid Grid.Row="0" Padding="20,16,12,8">
                        <TextBlock
                            Text="选择标签"
                            FontSize="17"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center" />
                        <Button
                            Width="30"
                            Height="30"
                            Padding="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="8"
                            Click="CloseLuoguFilter_Click"
                            ToolTipService.ToolTip="关闭">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </Grid>

                    <!-- 题目难度 -->
                    <StackPanel Grid.Row="1" Padding="20,0,20,8" Spacing="6">
                        <TextBlock
                            Text="题目难度"
                            FontSize="12"
                            Opacity="0.6" />
                        <StackPanel x:Name="DifficultyChipsHost" Spacing="8" />
                    </StackPanel>

                    <!-- 算法 / 来源 / 时间 / 区域 / 特殊题目 -->
                    <StackPanel
                        Grid.Row="2"
                        Padding="20,4,20,0"
                        Orientation="Horizontal"
                        Spacing="2">
                        <ToggleButton
                            x:Name="FilterTabAlgorithm"
                            Tag="2"
                            Content="算法"
                            IsChecked="True"
                            Style="{StaticResource LuoguFilterTabStyle}"
                            Click="FilterTab_Click" />
                        <ToggleButton
                            x:Name="FilterTabSource"
                            Tag="3"
                            Content="来源"
                            Style="{StaticResource LuoguFilterTabStyle}"
                            Click="FilterTab_Click" />
                        <ToggleButton
                            x:Name="FilterTabTime"
                            Tag="4"
                            Content="时间"
                            Style="{StaticResource LuoguFilterTabStyle}"
                            Click="FilterTab_Click" />
                        <ToggleButton
                            x:Name="FilterTabRegion"
                            Tag="1"
                            Content="区域"
                            Style="{StaticResource LuoguFilterTabStyle}"
                            Click="FilterTab_Click" />
                        <ToggleButton
                            x:Name="FilterTabSpecial"
                            Tag="5"
                            Content="特殊题目"
                            Style="{StaticResource LuoguFilterTabStyle}"
                            Click="FilterTab_Click" />
                    </StackPanel>

                    <!-- 已选 + 标签搜索 -->
                    <Grid Grid.Row="3" Padding="20,10,20,8" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="FilterSelectedText"
                                FontSize="12"
                                VerticalAlignment="Center"
                                Text="已选标签（0）" />
                            <Button
                                Grid.Column="1"
                                Height="28"
                                Padding="10,0"
                                CornerRadius="6"
                                FontSize="12"
                                Content="清除"
                                Click="ClearLuoguFilter_Click" />
                        </Grid>
                        <TextBlock
                            x:Name="FilterSelectedNames"
                            Grid.Row="1"
                            FontSize="11"
                            MaxLines="2"
                            Opacity="0.55"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                        <TextBox
                            x:Name="FilterSearchBox"
                            Grid.Row="2"
                            Height="36"
                            Padding="12,7,12,7"
                            PlaceholderText="搜索全部标签"
                            FontSize="12"
                            CornerRadius="8"
                            TextChanged="FilterSearchBox_TextChanged" />
                    </Grid>

                    <!-- 标签分组 -->
                    <ScrollViewer
                        Grid.Row="4"
                        Padding="20,0,20,0"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel
                            x:Name="FilterTagHost"
                            Margin="0,4,0,12"
                            Spacing="14" />
                    </ScrollViewer>

                    <!-- 底部 -->
                    <Grid Grid.Row="5" Padding="20,12,20,16" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            FontSize="11"
                            VerticalAlignment="Center"
                            Opacity="0.45"
                            Text="条件来自洛谷官方题库" />
                        <Button
                            Grid.Column="1"
                            Height="32"
                            Padding="16,0"
                            CornerRadius="8"
                            FontSize="12"
                            Content="取消"
                            Click="CloseLuoguFilter_Click" />
                        <Button
                            Grid.Column="2"
                            Height="32"
                            Padding="20,0"
                            CornerRadius="8"
                            FontSize="12"
                            Content="确认"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="ConfirmLuoguFilter_Click"
                            AutomationProperties.AutomationId="LuoguFilterConfirmButton" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 测试浮层 -->
        <Grid
            x:Name="TestOverlay"
            Background="#66000000"
            Visibility="Collapsed"
            AutomationProperties.AutomationId="PracticeTestOverlay">
            <Border
                Width="760"
                MaxHeight="660"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 标题 -->
                    <Grid Padding="20,16,12,10" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock
                                x:Name="TestTitleText"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Text="测试" />
                            <TextBlock
                                x:Name="TestSubtitleText"
                                FontSize="11"
                                Opacity="0.55" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            Width="30"
                            Height="30"
                            Padding="0"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="8"
                            Click="CloseTest_Click">
                            <FontIcon FontSize="12" Glyph="&#xE711;" />
                        </Button>
                    </Grid>

                    <!-- 选择样例 / 手动输入 -->
                    <Grid
                        x:Name="TestSetupPanel"
                        Grid.Row="1"
                        Padding="20,0,20,8"
                        RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <RadioButton
                                x:Name="TestSampleMode"
                                Content="样例"
                                IsChecked="True"
                                Checked="TestMode_Checked" />
                            <RadioButton
                                x:Name="TestManualMode"
                                Content="手动输入"
                                Checked="TestMode_Checked" />
                        </StackPanel>

                        <Grid x:Name="TestSampleSection" Grid.Row="1" RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Opacity="0.55"
                                    Text="选择要运行的样例" />
                                <HyperlinkButton
                                    Grid.Column="1"
                                    Padding="6,2"
                                    FontSize="12"
                                    Content="全选"
                                    Click="TestSelectAll_Click" />
                                <HyperlinkButton
                                    Grid.Column="2"
                                    Padding="6,2"
                                    FontSize="12"
                                    Content="全不选"
                                    Click="TestSelectNone_Click" />
                            </Grid>
                            <ListView
                                x:Name="TestSampleList"
                                Grid.Row="1"
                                MaxHeight="300"
                                ItemTemplate="{StaticResource TestSampleItemTemplate}"
                                SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="MinHeight" Value="0" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,6" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                            </ListView>
                        </Grid>

                        <StackPanel
                            x:Name="TestManualSection"
                            Grid.Row="1"
                            Spacing="6"
                            Visibility="Collapsed">
                            <TextBlock FontSize="11" Opacity="0.55" Text="标准输入" />
                            <TextBox
                                x:Name="TestManualInput"
                                Height="230"
                                AcceptsReturn="True"
                                FontFamily="Cascadia Mono, Consolas, monospace"
                                FontSize="12"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock
                            x:Name="TestHintText"
                            Grid.Row="2"
                            FontSize="11"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                    </Grid>

                    <!-- 结果 -->
                    <Grid
                        x:Name="TestResultPanel"
                        Grid.Row="1"
                        Padding="20,0,20,8"
                        RowSpacing="8"
                        Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border
                            x:Name="TestCompileErrorBox"
                            Padding="10,8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="TestCompileError"
                                FontFamily="Cascadia Mono, Consolas, monospace"
                                FontSize="11"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                IsTextSelectionEnabled="True"
                                TextWrapping="Wrap" />
                        </Border>
                        <ListView
                            x:Name="TestResultList"
                            Grid.Row="1"
                            MaxHeight="440"
                            ItemTemplate="{StaticResource TestResultTemplate}"
                            SelectionMode="None" />
                    </Grid>

                    <!-- 底部按钮 -->
                    <Grid Grid.Row="2" Padding="20,12,20,16" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressRing
                            x:Name="TestRunRing"
                            Width="16"
                            Height="16"
                            VerticalAlignment="Center"
                            IsActive="False"
                            Visibility="Collapsed" />
                        <Button
                            x:Name="TestBackButton"
                            Grid.Column="2"
                            Height="32"
                            Padding="16,0"
                            CornerRadius="8"
                            FontSize="12"
                            Content="重新选择"
                            Click="TestBack_Click"
                            Visibility="Collapsed" />
                        <Button
                            x:Name="TestCloseButton"
                            Grid.Column="3"
                            Height="32"
                            Padding="16,0"
                            CornerRadius="8"
                            FontSize="12"
                            Content="关闭"
                            Click="CloseTest_Click"
                            Visibility="Collapsed" />
                        <Button
                            x:Name="RunTestButton"
                            Grid.Column="4"
                            Height="32"
                            Padding="20,0"
                            CornerRadius="8"
                            FontSize="12"
                            Content="运行测试"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="RunTests_Click"
                            AutomationProperties.AutomationId="PracticeRunTestButton" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 登录平台选择：主页登录入口点开后先选平台 -->
        <Grid
            x:Name="LoginPlatformOverlay"
            Background="#66000000"
            Visibility="Collapsed"
            AutomationProperties.AutomationId="PracticeLoginPlatformOverlay">
            <Border
                Width="440"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel Padding="22,20,22,22" Spacing="14">
                    <Grid>
                        <StackPanel Spacing="3">
                            <TextBlock Text="登录" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="选择要登录的平台，登录状态会实时同步" FontSize="11" Opacity="0.55" />
                        </StackPanel>
                        <Button
                            Width="30"
                            Height="30"
                            Padding="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="8"
                            Click="CloseLoginPlatform_Click"
                            ToolTipService.ToolTip="关闭"
                            AutomationProperties.AutomationId="PracticeLoginPlatformCloseButton">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </Grid>
                    <Button
                        Tag="luogu"
                        Height="60"
                        Padding="14,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        CornerRadius="10"
                        Click="LoginPlatformChoice_Click"
                        AutomationProperties.AutomationId="PracticeLoginPlatformLuogu">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image x:Name="LoginPlatformLuoguIcon" Grid.Column="0" Width="26" Height="26" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="洛谷" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock x:Name="LoginPlatformLuoguState" Text="未登录" FontSize="11" Opacity="0.55" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Opacity="0.35" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button
                        Tag="atcoder"
                        Height="60"
                        Padding="14,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        CornerRadius="10"
                        Click="LoginPlatformChoice_Click"
                        AutomationProperties.AutomationId="PracticeLoginPlatformAtCoder">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image x:Name="LoginPlatformAtCoderIcon" Grid.Column="0" Width="26" Height="26" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="AtCoder" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock x:Name="LoginPlatformAtCoderState" Text="未登录" FontSize="11" Opacity="0.55" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Opacity="0.35" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button
                        Tag="nowcoder"
                        Height="60"
                        Padding="14,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        CornerRadius="10"
                        Click="LoginPlatformChoice_Click"
                        AutomationProperties.AutomationId="PracticeLoginPlatformNowCoder">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image x:Name="LoginPlatformNowCoderIcon" Grid.Column="0" Width="26" Height="26" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="牛客" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock x:Name="LoginPlatformNowCoderState" Text="未登录" FontSize="11" Opacity="0.55" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Opacity="0.35" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 登录浮层：圆角 WebView2 -->
        <Grid
            x:Name="LoginOverlay"
            Background="#99000000"
            Visibility="Collapsed"
            AutomationProperties.AutomationId="PracticeLoginOverlay">
            <Border
                x:Name="LoginBorder"
                Margin="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Padding="16,10" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="1">
                            <TextBlock x:Name="LoginTitleText" Text="登录" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock
                                x:Name="LoginHintText"
                                Text=""
                                FontSize="11"
                                Opacity="0.55" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <ProgressRing
                                x:Name="LoginRing"
                                Width="16"
                                Height="16"
                                IsActive="False"
                                Visibility="Collapsed" />
                            <Button
                                Width="30"
                                Height="30"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="8"
                                Click="CloseLogin_Click"
                                ToolTipService.ToolTip="关闭"
                                AutomationProperties.AutomationId="PracticeLoginCloseButton">
                                <FontIcon Glyph="&#xE711;" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Border
                        Grid.Row="1"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,12,12"
                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                        <Grid>
                            <!-- 底部留出圆角背景：WebView2 的原生画面不会被父级圆角裁切 -->
                            <WebView2 x:Name="LoginWebView" Margin="0,0,0,10" />
                            <!-- 加载占位：页面加载完成前遮住 WebView 白屏，加载后再显示内容 -->
                            <Grid x:Name="LoginLoadingPanel" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                    <ProgressRing Width="36" Height="36" IsActive="True" />
                                    <TextBlock Text="页面加载中…" FontSize="13" Opacity="0.6" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 验证码浮层：把触发了验证码的页面交给用户手动完成 -->
        <Grid
            x:Name="CaptchaOverlay"
            Background="#99000000"
            Visibility="Collapsed"
            AutomationProperties.AutomationId="PracticeCaptchaOverlay">
            <Border
                Width="900"
                Height="640"
                MaxWidth="1000"
                MaxHeight="720"
                Margin="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Padding="16,10" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="1">
                            <TextBlock Text="需要验证" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock
                                Text="洛谷要求人机验证，请在下方完成后点击「我已完成」，搜索会自动继续。"
                                FontSize="11"
                                Opacity="0.55" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button
                                Content="我已完成"
                                Height="30"
                                Padding="12,0"
                                CornerRadius="8"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="CaptchaDone_Click"
                                AutomationProperties.AutomationId="PracticeCaptchaDoneButton" />
                            <Button
                                Width="30"
                                Height="30"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="8"
                                Click="CaptchaCancel_Click"
                                ToolTipService.ToolTip="跳过">
                                <FontIcon Glyph="&#xE711;" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Border
                        Grid.Row="1"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,12,12">
                        <WebView2 x:Name="CaptchaWebView" Margin="0,0,0,10" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 搜索加载浮层：微软商店风格，居中的大进度环 -->
        <Grid x:Name="SearchLoadingOverlay" Visibility="Collapsed" Background="Transparent">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16">
                <ProgressRing
                    x:Name="SearchLoadingRing"
                    Width="56"
                    Height="56"
                    IsActive="True"
                    Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                <TextBlock
                    x:Name="SearchLoadingText"
                    FontSize="13"
                    Opacity="0.7"
                    HorizontalAlignment="Center"
                    Text="正在搜索…" />
                <Button
                    Content="取消"
                    Height="30"
                    Padding="16,0"
                    CornerRadius="8"
                    FontSize="12"
                    HorizontalAlignment="Center"
                    Click="CancelSearch_Click" />
            </StackPanel>
        </Grid>

        <!-- 后台抓取用的隐藏浏览器：桌面尺寸但挪到可视区外，保证站点按 PC 端布局渲染
             （2px 视口会让部分站点切到移动端布局，抓不到想要的节点） -->
        <Grid
            Width="1280"
            Height="800"
            Margin="-4000,-4000,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsHitTestVisible="False">
            <WebView2 x:Name="FetchWebView" />
        </Grid>
    </Grid>
</UserControl>
