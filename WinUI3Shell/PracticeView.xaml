<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinUI3Shell.PracticeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:oj="using:WinUI3Shell.Oj">

    <UserControl.Resources>
        <!-- 界面图标统一用系统实际存在的图标字体（Windows 10 无 Segoe Fluent Icons） -->
        <Style TargetType="FontIcon">
            <Setter Property="FontFamily" Value="{StaticResource IconFontFamily}" />
        </Style>

        <!-- OJ 筛选：只有图标，选中/未选中靠不透明度区分，不用彩色胶囊 -->
        <Style x:Key="OjIconToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid x:Name="OjIconRoot" Background="Transparent" Opacity="0.2">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="OjIconRoot.Opacity" Value="0.45" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="OjIconRoot.Opacity" Value="0.7" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="OjIconRoot.Opacity" Value="0.12" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="OjIconRoot.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="OjIconRoot.Opacity" Value="0.9" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="OjIconRoot.Opacity" Value="0.7" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedDisabled">
                                        <VisualState.Setters>
                                            <Setter Target="OjIconRoot.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 洛谷筛选面板：标签胶囊 -->
        <Style x:Key="LuoguFilterChipStyle" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <!-- 洛谷筛选面板：顶部标签页，选中时显示强调色下划线 -->
        <Style x:Key="LuoguFilterTabStyle" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="TabContent.Opacity" Value="0.85" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="TabContent.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled" />
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="TabUnderline.Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                            <Setter Target="TabContent.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="TabUnderline.Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                            <Setter Target="TabContent.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="TabUnderline.Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                            <Setter Target="TabContent.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter
                                x:Name="TabContent"
                                Margin="0,0,0,2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                Opacity="0.6" />
                            <Border
                                x:Name="TabUnderline"
                                Height="2"
                                VerticalAlignment="Bottom"
                                Background="Transparent"
                                CornerRadius="1" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ProblemItemTemplate" x:DataType="oj:OjProblemItem">
            <Grid ColumnSpacing="10" Padding="2,4" AutomationProperties.Name="{x:Bind DisplayName}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image
                    Grid.Column="0"
                    Width="20"
                    Height="20"
                    VerticalAlignment="Center"
                    Opacity="0.9"
                    Source="{x:Bind Icon, Mode=OneWay}" />
                <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock
                        Text="{x:Bind Title}"
                        TextTrimming="CharacterEllipsis"
                        MaxLines="1"
                        FontSize="13" />
                    <TextBlock
                        Text="{x:Bind Meta}"
                        TextTrimming="CharacterEllipsis"
                        MaxLines="1"
                        FontSize="11"
                        Opacity="0.6" />
                </StackPanel>
                <Button
                    Grid.Column="2"
                    Width="28"
                    Height="28"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="6"
                    Click="StarResult_Click"
                    Tag="{x:Bind Key}"
                    ToolTipService.ToolTip="标星">
                    <FontIcon
                        Glyph="{x:Bind StarGlyph, Mode=OneWay}"
                        FontSize="14"
                        Foreground="{x:Bind StarForeground, Mode=OneWay}" />
                </Button>
                <TextBlock
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Text="{x:Bind Id}"
                    FontSize="11"
                    Opacity="0.5" />
            </Grid>
        </DataTemplate>

        <!-- 洛谷题目：最左侧展示当前账号的答题状态（已答对 / 答错 / 未作答） -->
        <DataTemplate x:Key="LuoguProblemItemTemplate" x:DataType="oj:OjProblemItem">
            <Grid ColumnSpacing="10" Padding="2,4" AutomationProperties.Name="{x:Bind DisplayName}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Glyph="{x:Bind AnswerStateGlyph, Mode=OneWay}"
                    Foreground="{x:Bind AnswerStateBrush, Mode=OneWay}"
                    Visibility="{x:Bind AnswerStateVisibility, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind AnswerStateTip, Mode=OneWay}" />
                <Image
                    Grid.Column="1"
                    Width="20"
                    Height="20"
                    VerticalAlignment="Center"
                    Opacity="0.9"
                    Source="{x:Bind Icon, Mode=OneWay}" />
                <StackPanel Grid.Column="2" Spacing="1">
                    <TextBlock
                        Text="{x:Bind Title}"
                        TextTrimming="CharacterEllipsis"
                        MaxLines="1"
                        FontSize="13" />
                    <TextBlock
                        Text="{x:Bind Meta}"
                        TextTrimming="CharacterEllipsis"
                        MaxLines="1"
                        FontSize="11"
                        Opacity="0.6" />
                </StackPanel>
                <Button
                    Grid.Column="3"
                    Width="28"
                    Height="28"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="6"
                    Click="StarResult_Click"
                    Tag="{x:Bind Key}"
                    ToolTipService.ToolTip="标星">
                    <FontIcon
                        Glyph="{x:Bind StarGlyph, Mode=OneWay}"
                        FontSize="14"
                        Foreground="{x:Bind StarForeground, Mode=OneWay}" />
                </Button>
                <TextBlock
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    Text="{x:Bind Id}"
                    FontSize="11"
                    Opacity="0.5" />
            </Grid>
        </DataTemplate>

        <!-- 题单卡片 -->
        <DataTemplate x:Key="TrainingCardTemplate" x:DataType="oj:LuoguTrainingSummary">
            <Border
                Width="378"
                Height="96"
                Padding="18,14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Spacing="5">
                        <TextBlock
                            Text="{x:Bind Title}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Text="{x:Bind Meta}"
                            FontSize="11"
                            Opacity="0.55" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Text="{x:Bind Index}"
                        FontSize="26"
                        FontWeight="Bold"
                        Opacity="0.1" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 题单板块卡片 -->
        <DataTemplate x:Key="TrainingCategoryTemplate" x:DataType="oj:LuoguCategory">
            <Border
                Width="378"
                Height="96"
                Padding="18,14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Spacing="5">
                        <TextBlock
                            Text="{x:Bind Name}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Text="查看题单"
                            FontSize="11"
                            Opacity="0.55" />
                    </StackPanel>
                    <FontIcon
                        Grid.Column="1"
                        Margin="12,0,2,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Glyph="&#xE76C;"
                        Opacity="0.35" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 题单里的题目：难度圆点 + 题号 + 标题 -->
        <DataTemplate x:Key="TrainingProblemTemplate" x:DataType="oj:OjProblemItem">
            <Grid ColumnSpacing="10" Padding="2,4" AutomationProperties.Name="{x:Bind DisplayName}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    MinWidth="66"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontFamily="Cascadia Mono, Consolas, monospace"
                    Opacity="0.55"
                    Text="{x:Bind Id}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="13"
                    MaxLines="1"
                    Text="{x:Bind Title}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Opacity="0.55"
                    Text="{x:Bind DifficultyName}" />
                <Button
                    Grid.Column="3"
                    Width="28"
                    Height="28"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="6"
                    Click="StarResult_Click"
                    Tag="{x:Bind Key}">
                    <FontIcon
                        FontSize="14"
                        Foreground="{x:Bind StarForeground, Mode=OneWay}"
                        Glyph="{x:Bind StarGlyph, Mode=OneWay}" />
                </Button>
            </Grid>
        </DataTemplate>
        <!-- 测试面板：选择样例 / 手动输入 -->
        <DataTemplate x:Key="TestSampleItemTemplate" x:DataType="oj:OjSample">
            <CheckBox
                MinWidth="0"
                Padding="10,4,0,4"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                IsChecked="{x:Bind IsSelected, Mode=TwoWay}">
                <StackPanel Spacing="4">
                    <TextBlock FontSize="13" Text="{x:Bind Title}" />
                    <TextBlock
                        FontFamily="Cascadia Mono, Consolas, monospace"
                        FontSize="11"
                        MaxLines="4"
                        Opacity="0.5"
                        Text="{x:Bind Input}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                </StackPanel>
            </CheckBox>
        </DataTemplate>

        <!-- 测试结果卡片 -->
        <DataTemplate x:Key="TestResultTemplate" x:DataType="oj:TestResultItem">
            <Border
                Margin="0,0,0,8"
                Padding="12,10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Grid.Column="0"
                            FontSize="13"
                            Foreground="{x:Bind StatusBrush}"
                            Glyph="{x:Bind Glyph}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Text="{x:Bind Title}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{x:Bind StatusBrush}"
                            Text="{x:Bind Status}" />
                    </Grid>
                    <TextBlock
                        FontFamily="Cascadia Mono, Consolas, monospace"
                        FontSize="11"
                        IsTextSelectionEnabled="True"
                        Opacity="0.75"
                        Text="{x:Bind Detail}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind DetailVisibility}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="PracticeRoot" KeyDown="PracticeRoot_KeyDown" Background="Transparent">
        <!-- 首页：大标题 + 搜索框 + OJ 图标筛选 -->
        <Grid x:Name="HomePanel" Padding="0,0,0,40" AutomationProperties.AutomationId="PracticeHomePanel">
            <!-- 右上角：三个平台的登录状态 + 登录入口 + 标星入口 -->
            <StackPanel
                Orientation="Horizontal"
                Spacing="10"
                Margin="0,24,28,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="12"
                    VerticalAlignment="Center"
                    Margin="0,0,2,0"
                    AutomationProperties.AutomationId="PracticeLoginStatusStrip">
                    <StackPanel Orientation="Horizontal" Spacing="5" ToolTipService.ToolTip="洛谷登录状态">
                        <Image x:Name="LuoguStatusIcon" Width="16" Height="16" VerticalAlignment="Center" />
                        <Ellipse x:Name="LuoguStatusDot" Width="7" Height="7" VerticalAlignment="Center" Fill="#8A8A8A" />
                        <TextBlock x:Name="LuoguStatusLabel" Text="未登录" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="5" ToolTipService.ToolTip="AtCoder 登录状态">
                        <Image x:Name="AtCoderStatusIcon" Width="16" Height="16" VerticalAlignment="Center" />
                        <Ellipse x:Name="AtCoderStatusDot" Width="7" Height="7" VerticalAlignment="Center" Fill="#8A8A8A" />
                        <TextBlock x:Name="AtCoderStatusLabel" Text="未登录" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="5" ToolTipService.ToolTip="牛客登录状态">
                        <Image x:Name="NowCoderStatusIcon" Width="16" Height="16" VerticalAlignment="Center" />
                        <Ellipse x:Name="NowCoderStatusDot" Width="7" Height="7" VerticalAlignment="Center" Fill="#8A8A8A" />
                        <TextBlock x:Name="NowCoderStatusLabel" Text="未登录" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
                <Button
                    x:Name="HomeLoginButton"
                    Height="36"
                    Padding="14,0"
                    CornerRadius="10"
                    Click="HomeLoginButton_Click"
                    ToolTipService.ToolTip="登录刷题平台"
                    AutomationProperties.AutomationId="PracticeHomeLoginButton">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE77B;" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="登录" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="HomeStarButton"
                    Width="40"
                    Height="36"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="10"
                    Click="HomeStarButton_Click"
                    ToolTipService.ToolTip="标星题目">
                    <FontIcon Glyph="&#xE734;" FontSize="18" Opacity="0.7" />
                </Button>
            </StackPanel>
            <StackPanel
                x:Name="HomeStack"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="18">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="HomeStackTransform" />
                </StackPanel.RenderTransform>
                <TextBlock
                    Text="刷题模式"
                    FontSize="46"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center" />
                <TextBlock
                    Text="BETA"
                    FontSize="13"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"
                    Opacity="0.45"
                    Margin="0,-10,0,0" />
                <Grid
                    Width="440"
                    HorizontalAlignment="Center">
                    <TextBox
                        x:Name="SearchBox"
                        Padding="52,13,16,13"
                        PlaceholderText="搜索题目"
                        FontSize="15"
                        Height="46"
                        CornerRadius="12"
                        KeyDown="SearchBox_KeyDown"
                        AutomationProperties.AutomationId="PracticeSearchBox" />
                    <Button
                        Width="36"
                        Height="36"
                        Margin="5,0,0,0"
                        Padding="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="8"
                        Click="SearchSubmit_Click"
                        ToolTipService.ToolTip="搜索"
                        AutomationProperties.Name="搜索">
                        <FontIcon Glyph="&#xE721;" FontSize="15" />
                    </Button>
                </Grid>
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="RandomProblemButton"
                        Height="38"
                        Padding="18,0"
                        CornerRadius="10"
                        Click="RandomProblem_Click"
                        ToolTipService.ToolTip="随机抽一道洛谷题目"
                        AutomationProperties.AutomationId="PracticeRandomButton">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE8B1;" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="随机抽题" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button
                        Height="38"
                        Padding="18,0"
                        CornerRadius="10"
                        Click="TrainingButton_Click"
                        AutomationProperties.AutomationId="PracticeTrainingButton">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE8FD;" FontSize="14" />
                            <TextBlock Text="洛谷题单" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Grid Width="220" Height="44" HorizontalAlignment="Center" Margin="0,2,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <ToggleButton
                        x:Name="LuoguToggle"
                        Tag="luogu"
                        IsChecked="True"
                        Style="{StaticResource OjIconToggleStyle}"
                        ToolTipService.ToolTip="洛谷"
                        Click="OjToggle_Click">
                        <Image x:Name="LuoguIcon" Width="28" Height="28" />
                    </ToggleButton>
                    <ToggleButton
                        x:Name="AtCoderToggle"
                        Tag="atcoder"
                        IsChecked="True"
                        Style="{StaticResource OjIconToggleStyle}"
                        ToolTipService.ToolTip="AtCoder"
                        Click="OjToggle_Click">
                        <Image x:Name="AtCoderIcon" Width="28" Height="28" />
                    </ToggleButton>
                    <ToggleButton
                        x:Name="NowCoderToggle"
                        Tag="nowcoder"
                        IsChecked="True"
                        Style="{StaticResource OjIconToggleStyle}"
                        ToolTipService.ToolTip="牛客"
                        Click="OjToggle_Click">
                        <Image x:Name="NowCoderIcon" Width="28" Height="28" />
                    </ToggleButton>
                    </StackPanel>
                    <!-- 提示气泡：纯展示、不拦截输入，点击可穿透到下面的控件 -->
                    <Border
                        x:Name="OjTipBubble"
                        Width="220"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,-38"
                        Padding="12,6"
                        CornerRadius="6"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        IsHitTestVisible="False"
                        Opacity="0">
                        <TextBlock x:Name="OjTipText" FontSize="12" />
                    </Border>
                </Grid>
                <TextBlock
                    x:Name="OjSourceHint"
                    Text="请至少打亮一个搜索源"
                    FontSize="12"
                    Height="18"
                    Margin="0,-8,0,0"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                    Opacity="0" />
                <Button
                    x:Name="LuoguModuleButton"
                    Height="38"
                    Padding="18,0"
                    Margin="0,2,0,0"
                    HorizontalAlignment="Center"
                    CornerRadius="10"
                    Click="LuoguModuleButton_Click"
                    ToolTipService.ToolTip="进入独立的洛谷刷题模式"
                    AutomationProperties.AutomationId="PracticeLuoguModuleButton">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image
                            x:Name="LuoguModuleIcon"
                            Width="20"
                            Height="20"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Text="洛谷刷题模式"
                            FontSize="13"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 洛谷独立刷题模式 -->
        <Grid x:Name="LuoguPanel" Visibility="Collapsed" AutomationProperties.AutomationId="PracticeLuoguPanel">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="LuoguTransform" />
            </Grid.RenderTransform>
            <Button
                Width="40"
                Height="40"
                Padding="0"
                Margin="20,20,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="Transparent"
                BorderThickness="0"
                CornerRadius="10"
                Click="LuoguBack_Click"
                ToolTipService.ToolTip="返回刷题模式">
                <FontIcon Glyph="&#xE72B;" FontSize="16" Opacity="0.7" />
            </Button>
            <StackPanel
