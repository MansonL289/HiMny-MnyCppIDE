                            SelectionMode="None">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid ItemWidth="390" ItemHeight="104" Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                        </GridView>

                        <TextBlock
                            x:Name="MonthHeader"
                            Margin="4,10,0,4"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Opacity="0.6"
