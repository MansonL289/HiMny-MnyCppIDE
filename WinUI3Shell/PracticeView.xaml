<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinUI3Shell.PracticeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:oj="using:WinUI3Shell.Oj">

    <UserControl.Resources>
        <!-- OJ 筛选：只有图标，选中/未选中靠不透明度区分，不用彩色胶囊 -->
        <Style x:Key="OjIconToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid x:Name="OjIconRoot" Background="Transparent" Opacity="0.2">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="OjIconRoot.Opacity" Value="0.45" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="OjIconRoot.Opacity" Value="0.7" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="OjIconRoot.Opacity" Value="0.12" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="OjIconRoot.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="OjIconRoot.Opacity" Value="0.9" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="OjIconRoot.Opacity" Value="0.7" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedDisabled">
                                        <VisualState.Setters>
                                            <Setter Target="OjIconRoot.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ProblemItemTemplate" x:DataType="oj:OjProblemItem">
            <Grid ColumnSpacing="10" Padding="2,4" AutomationProperties.Name="{x:Bind DisplayName}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image
                    Grid.Column="0"
                    Width="20"
                    Height="20"
                    VerticalAlignment="Center"
                    Opacity="0.9"
                    Source="{x:Bind Icon, Mode=OneWay}" />
                <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock
                        Text="{x:Bind Title}"
                        TextTrimming="CharacterEllipsis"
                        MaxLines="1"
                        FontSize="13" />
                    <TextBlock
                        Text="{x:Bind Meta}"
                        TextTrimming="CharacterEllipsis"
                        MaxLines="1"
                        FontSize="11"
                        Opacity="0.6" />
                </StackPanel>
                <Button
                    Grid.Column="2"
                    Width="28"
                    Height="28"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="6"
                    Click="StarResult_Click"
                    Tag="{x:Bind Key}"
                    ToolTipService.ToolTip="标星">
                    <FontIcon
                        Glyph="{x:Bind StarGlyph, Mode=OneWay}"
                        FontSize="14"
                        Foreground="{x:Bind StarForeground, Mode=OneWay}" />
                </Button>
                <TextBlock
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Text="{x:Bind Id}"
                    FontSize="11"
                    Opacity="0.5" />
            </Grid>
        </DataTemplate>

        <!-- 题单卡片 -->
        <DataTemplate x:Key="TrainingCardTemplate" x:DataType="oj:LuoguTrainingSummary">
            <Border
                Width="378"
                Height="96"
                Padding="18,14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Spacing="5">
                        <TextBlock
                            Text="{x:Bind Title}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Text="{x:Bind Meta}"
                            FontSize="11"
                            Opacity="0.55" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Text="{x:Bind Index}"
                        FontSize="26"
                        FontWeight="Bold"
                        Opacity="0.1" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 题单板块卡片 -->
        <DataTemplate x:Key="TrainingCategoryTemplate" x:DataType="oj:LuoguCategory">
            <Border
                Width="378"
                Height="96"
                Padding="18,14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Spacing="5">
                        <TextBlock
                            Text="{x:Bind Name}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Text="查看题单"
                            FontSize="11"
                            Opacity="0.55" />
                    </StackPanel>
                    <FontIcon
                        Grid.Column="1"
                        Margin="12,0,2,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Glyph="&#xE76C;"
                        Opacity="0.35" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 题单里的题目：难度圆点 + 题号 + 标题 -->
        <DataTemplate x:Key="TrainingProblemTemplate" x:DataType="oj:OjProblemItem">
            <Grid ColumnSpacing="10" Padding="2,4" AutomationProperties.Name="{x:Bind DisplayName}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    MinWidth="66"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontFamily="Cascadia Mono, Consolas, monospace"
                    Opacity="0.55"
                    Text="{x:Bind Id}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="13"
                    MaxLines="1"
                    Text="{x:Bind Title}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Opacity="0.55"
                    Text="{x:Bind DifficultyName}" />
                <Button
                    Grid.Column="3"
                    Width="28"
                    Height="28"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="6"
                    Click="StarResult_Click"
                    Tag="{x:Bind Key}">
                    <FontIcon
                        FontSize="14"
                        Foreground="{x:Bind StarForeground, Mode=OneWay}"
                        Glyph="{x:Bind StarGlyph, Mode=OneWay}" />
                </Button>
            </Grid>
        </DataTemplate>
        <!-- 测试面板：选择样例 / 手动输入 -->
        <DataTemplate x:Key="TestSampleItemTemplate" x:DataType="oj:OjSample">
            <CheckBox
                MinWidth="0"
                Padding="10,4,0,4"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                IsChecked="{x:Bind IsSelected, Mode=TwoWay}">
                <StackPanel Spacing="4">
                    <TextBlock FontSize="13" Text="{x:Bind Title}" />
                    <TextBlock
                        FontFamily="Cascadia Mono, Consolas, monospace"
                        FontSize="11"
                        MaxLines="4"
                        Opacity="0.5"
                        Text="{x:Bind Input}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                </StackPanel>
            </CheckBox>
        </DataTemplate>

        <!-- 测试结果卡片 -->
        <DataTemplate x:Key="TestResultTemplate" x:DataType="oj:TestResultItem">
            <Border
                Margin="0,0,0,8"
                Padding="12,10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Grid.Column="0"
                            FontSize="13"
                            Foreground="{x:Bind StatusBrush}"
                            Glyph="{x:Bind Glyph}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Text="{x:Bind Title}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{x:Bind StatusBrush}"
                            Text="{x:Bind Status}" />
                    </Grid>
                    <TextBlock
                        FontFamily="Cascadia Mono, Consolas, monospace"
                        FontSize="11"
                        IsTextSelectionEnabled="True"
                        Opacity="0.75"
                        Text="{x:Bind Detail}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind DetailVisibility}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="PracticeRoot" KeyDown="PracticeRoot_KeyDown" Background="Transparent">
        <!-- 首页：大标题 + 搜索框 + OJ 图标筛选 -->
        <Grid x:Name="HomePanel" Padding="0,0,0,40" AutomationProperties.AutomationId="PracticeHomePanel">
            <Button
                x:Name="HomeStarButton"
                Width="40"
                Height="40"
                Padding="0"
                Margin="0,24,28,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="Transparent"
                BorderThickness="0"
                CornerRadius="10"
                Click="HomeStarButton_Click"
                ToolTipService.ToolTip="标星题目">
                <FontIcon Glyph="&#xE734;" FontSize="18" Opacity="0.7" />
            </Button>
            <StackPanel
                x:Name="HomeStack"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="18">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="HomeStackTransform" />
                </StackPanel.RenderTransform>
                <TextBlock
                    Text="刷题模式"
                    FontSize="46"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center" />
                <TextBlock
                    Text="BETA"
                    FontSize="13"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"
                    Opacity="0.45"
                    Margin="0,-10,0,0" />
                <Grid
                    Width="440"
                    HorizontalAlignment="Center">
                    <TextBox
                        x:Name="SearchBox"
                        Padding="16,13,52,13"
                        PlaceholderText="搜索题目"
                        FontSize="15"
                        Height="46"
                        CornerRadius="12"
                        KeyDown="SearchBox_KeyDown"
                        AutomationProperties.AutomationId="PracticeSearchBox" />
                    <Button
                        Width="36"
                        Height="36"
                        Margin="0,0,5,0"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="8"
                        Click="SearchSubmit_Click"
                        ToolTipService.ToolTip="搜索"
                        AutomationProperties.Name="搜索">
                        <FontIcon Glyph="&#xE721;" FontSize="15" />
                    </Button>
                </Grid>
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="RandomProblemButton"
                        Height="38"
                        Padding="18,0"
                        CornerRadius="10"
                        Click="RandomProblem_Click"
                        ToolTipService.ToolTip="随机抽一道洛谷题目"
                        AutomationProperties.AutomationId="PracticeRandomButton">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE8B1;" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="随机抽题" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button
                        Height="38"
                        Padding="18,0"
                        CornerRadius="10"
                        Click="TrainingButton_Click"
                        AutomationProperties.AutomationId="PracticeTrainingButton">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE8FD;" FontSize="14" />
                            <TextBlock Text="洛谷题单" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Grid HorizontalAlignment="Center" Margin="0,2,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                    <ToggleButton
                        x:Name="LuoguToggle"
                        Tag="luogu"
                        IsChecked="True"
                        Style="{StaticResource OjIconToggleStyle}"
                        ToolTipService.ToolTip="洛谷"
                        Click="OjToggle_Click">
                        <Image x:Name="LuoguIcon" Width="28" Height="28" />
                    </ToggleButton>
                    <ToggleButton
                        x:Name="AtCoderToggle"
                        Tag="atcoder"
                        IsChecked="True"
                        Style="{StaticResource OjIconToggleStyle}"
                        ToolTipService.ToolTip="AtCoder"
                        Click="OjToggle_Click">
                        <Image x:Name="AtCoderIcon" Width="28" Height="28" />
                    </ToggleButton>
                    <ToggleButton
                        x:Name="NowCoderToggle"
                        Tag="nowcoder"
                        IsChecked="True"
                        Style="{StaticResource OjIconToggleStyle}"
                        ToolTipService.ToolTip="牛客"
                        Click="OjToggle_Click">
                        <Image x:Name="NowCoderIcon" Width="28" Height="28" />
                    </ToggleButton>
                    </StackPanel>
                    <!-- 提示气泡：纯展示、不拦截输入，点击可穿透到下面的控件 -->
                    <Border
                        x:Name="OjTipBubble"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,-38"
                        Padding="12,6"
                        CornerRadius="6"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        IsHitTestVisible="False"
                        Visibility="Collapsed">
                        <TextBlock x:Name="OjTipText" FontSize="12" />
                    </Border>
                </Grid>
                <TextBlock
                    x:Name="OjSourceHint"
                    Text="请至少打亮一个搜索源"
                    FontSize="12"
                    Margin="0,-8,0,0"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                    Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <!-- 搜索结果 -->
        <Grid x:Name="ResultsPanel" Visibility="Collapsed" AutomationProperties.AutomationId="PracticeResultsPanel">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="ResultsTransform" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid
                Grid.Row="0"
                ColumnSpacing="10"
                Padding="24,14,24,10"
                MaxWidth="720"
                HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="0"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="8"
                    Click="BackToHome_Click"
                    ToolTipService.ToolTip="返回搜索">
                    <FontIcon Glyph="&#xE72B;" FontSize="15" />
                </Button>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock x:Name="ResultQueryText" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="ResultStatusText" FontSize="11" Opacity="0.55" Text="正在搜索…" />
                </StackPanel>
                <ComboBox
                    x:Name="SortComboBox"
                    Grid.Column="2"
                    Height="32"
                    MinWidth="130"
                    Padding="10,0"
                    CornerRadius="8"
                    FontSize="12"
                    SelectionChanged="SortComboBox_SelectionChanged"
                    AutomationProperties.AutomationId="PracticeSortComboBox">
                    <ComboBoxItem Content="提交量升序" Tag="SubmitAsc" IsSelected="True" />
                    <ComboBoxItem Content="提交量降序" Tag="SubmitDesc" />
                    <ComboBoxItem Content="通过率升序" Tag="PassRateAsc" />
                    <ComboBoxItem Content="通过率降序" Tag="PassRateDesc" />
                    <ComboBoxItem Content="难度升序" Tag="DifficultyAsc" />
                    <ComboBoxItem Content="难度降序" Tag="DifficultyDesc" />
                    <ComboBoxItem Content="标题字母" Tag="TitleAsc" />
                </ComboBox>
            </Grid>
            <ListView
                x:Name="ResultList"
                Grid.Row="1"
                Width="720"
                MaxWidth="720"
                HorizontalAlignment="Center"
                Margin="0,0,0,20"
                IsItemClickEnabled="True"
                ItemClick="ResultList_ItemClick"
                SelectionMode="None"
                ItemTemplate="{StaticResource ProblemItemTemplate}"
                CornerRadius="10"
                AutomationProperties.AutomationId="PracticeResultList" />
            <TextBlock
                x:Name="EmptyStateText"
                Grid.Row="1"
                Margin="0,80,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                FontSize="13"
                Opacity="0.55"
                TextWrapping="Wrap"
                TextAlignment="Center"
                Visibility="Collapsed" />
        </Grid>

        <!-- 标星题目列表 -->
        <Grid x:Name="StarredPanel" Visibility="Collapsed" AutomationProperties.AutomationId="PracticeStarredPanel">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="StarredTransform" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" ColumnSpacing="10" Padding="24,14,24,10" MaxWidth="720" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="0"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="8"
                    Click="StarredBack_Click"
                    ToolTipService.ToolTip="返回">
                    <FontIcon Glyph="&#xE72B;" FontSize="15" />
                </Button>
                <TextBlock
                    Grid.Column="1"
                    Text="标星题目"
                    FontSize="15"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
            </Grid>
            <ListView
                x:Name="StarredList"
                Grid.Row="1"
                Width="720"
                MaxWidth="720"
                HorizontalAlignment="Center"
                Margin="0,0,0,20"
                IsItemClickEnabled="True"
                ItemClick="StarredList_ItemClick"
                SelectionMode="None"
                ItemTemplate="{StaticResource ProblemItemTemplate}"
                CornerRadius="10" />
        </Grid>

        <!-- 洛谷官方题单 -->
        <Grid x:Name="TrainingPanel" Visibility="Collapsed" AutomationProperties.AutomationId="PracticeTrainingPanel">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="TrainingTransform" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid
                Grid.Row="0"
                Padding="24,14,24,10"
                MaxWidth="780"
                HorizontalAlignment="Center"
                ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="0"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="8"
                    Click="TrainingBackToHome_Click">
                    <FontIcon Glyph="&#xE72B;" FontSize="15" />
                </Button>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="洛谷题单" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock
                        x:Name="TrainingStatusText"
                        FontSize="11"
                        Opacity="0.55"
                        Text="官方训练题单" />
                </StackPanel>
                <ProgressRing
                    x:Name="TrainingRing"
                    Grid.Column="2"
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center"
                    IsActive="False"
                    Visibility="Collapsed" />
            </Grid>
            <Grid
                Grid.Row="1"
                Width="780"
                HorizontalAlignment="Center"
                Margin="0,0,0,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBox
                    x:Name="CategorySearchBox"
                    Grid.Row="0"
                    Padding="14,9,14,9"
                    CornerRadius="10"
                    FontSize="13"
                    PlaceholderText="搜索板块"
                    TextChanged="CategorySearch_TextChanged" />
                <ScrollViewer
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock
                            x:Name="SrqcHeader"
                            Margin="4,2,0,4"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Opacity="0.6"
                            Text="深入浅出" />
                        <GridView
                            x:Name="SrqcGrid"
                            IsItemClickEnabled="True"
                            ItemClick="CategoryGrid_ItemClick"
                            ItemTemplate="{StaticResource TrainingCategoryTemplate}"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollMode="Disabled"
                            SelectionMode="None">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid ItemWidth="390" ItemHeight="104" Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                        </GridView>

                        <TextBlock
                            x:Name="MonthHeader"
                            Margin="4,10,0,4"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Opacity="0.6"
                            Text="月赛" />
                        <GridView
                            x:Name="MonthGrid"
                            IsItemClickEnabled="True"
                            ItemClick="CategoryGrid_ItemClick"
                            ItemTemplate="{StaticResource TrainingCategoryTemplate}"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollMode="Disabled"
                            SelectionMode="None">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid ItemWidth="390" ItemHeight="104" Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                        </GridView>

                        <TextBlock
                            x:Name="ContestHeader"
                            Margin="4,10,0,4"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Opacity="0.6"
                            Text="竞赛" />
                        <GridView
                            x:Name="ContestGrid"
                            IsItemClickEnabled="True"
                            ItemClick="CategoryGrid_ItemClick"
                            ItemTemplate="{StaticResource TrainingCategoryTemplate}"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollMode="Disabled"
                            SelectionMode="None">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid ItemWidth="390" ItemHeight="104" Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                        </GridView>

                        <TextBlock
                            x:Name="BookHeader"
                            Margin="4,10,0,4"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Opacity="0.6"
                            Text="书籍" />
                        <GridView
                            x:Name="BookGrid"
                            IsItemClickEnabled="True"
                            ItemClick="CategoryGrid_ItemClick"
                            ItemTemplate="{StaticResource TrainingCategoryTemplate}"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollMode="Disabled"
                            SelectionMode="None">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid ItemWidth="390" ItemHeight="104" Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                        </GridView>

                        <TextBlock
                            x:Name="SelectHeader"
                            Margin="4,10,0,4"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Opacity="0.6"
                            Text="用户分享" />
                        <GridView
                            x:Name="SelectGrid"
                            IsItemClickEnabled="True"
                            ItemClick="CategoryGrid_ItemClick"
                            ItemTemplate="{StaticResource TrainingCategoryTemplate}"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollMode="Disabled"
                            SelectionMode="None">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid ItemWidth="390" ItemHeight="104" Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                        </GridView>
                    </StackPanel>
                </ScrollViewer>
                <TextBlock
                    x:Name="TrainingEmptyText"
                    Grid.Row="1"
                    Margin="0,80,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    FontSize="13"
                    Opacity="0.55"
                    Text="题单加载失败，请检查网络后重新打开"
                    Visibility="Collapsed" />
            </Grid>
        </Grid>

        <!-- 板块内的题单 -->
        <Grid x:Name="TrainingListPanel" Visibility="Collapsed" AutomationProperties.AutomationId="PracticeTrainingListPanel">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="TrainingListTransform" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid
                Grid.Row="0"
                Padding="24,14,24,10"
                MaxWidth="780"
                HorizontalAlignment="Center"
                ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="0"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="8"
                    Click="TrainingListBack_Click">
                    <FontIcon Glyph="&#xE72B;" FontSize="15" />
                </Button>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock
                        x:Name="TrainingListTitle"
                        FontSize="15"
                        FontWeight="SemiBold"
                        MaxLines="1"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="TrainingListStatus"
                        FontSize="11"
                        Opacity="0.55" />
                </StackPanel>
                <ProgressRing
                    x:Name="TrainingListRing"
                    Grid.Column="2"
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center"
                    IsActive="False"
                    Visibility="Collapsed" />
            </Grid>
            <TextBox
                x:Name="TrainingSearchBox"
                Grid.Row="1"
                Width="780"
                Margin="0,0,0,4"
                Padding="14,9,14,9"
                HorizontalAlignment="Center"
                CornerRadius="10"
                FontSize="13"
                PlaceholderText="搜索本板块所有题单里的题目"
                TextChanged="TrainingSearch_TextChanged" />
            <GridView
                x:Name="TrainingGrid"
                Grid.Row="2"
                Width="780"
                Margin="0,0,0,8"
                HorizontalAlignment="Center"
                IsItemClickEnabled="True"
                ItemClick="TrainingGrid_ItemClick"
                ItemTemplate="{StaticResource TrainingCardTemplate}"
                SelectionMode="None">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid ItemWidth="390" ItemHeight="104" Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
            </GridView>
            <ListView
                x:Name="TrainingSearchResultList"
                Grid.Row="2"
                Width="780"
                Margin="0,0,0,8"
                HorizontalAlignment="Center"
                IsItemClickEnabled="True"
                ItemClick="TrainingSearchResult_ItemClick"
                ItemTemplate="{StaticResource TrainingProblemTemplate}"
                SelectionMode="None"
                Visibility="Collapsed" />
            <TextBlock
                x:Name="TrainingSearchEmptyText"
                Grid.Row="2"
                Margin="0,40,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                FontSize="12"
                Opacity="0.5"
                Text="没有匹配的题目"
                Visibility="Collapsed" />
            <Button
                x:Name="TrainingMoreButton"
                Grid.Row="3"
                Margin="0,0,0,16"
                Padding="18,5"
                HorizontalAlignment="Center"
                CornerRadius="8"
                Click="TrainingMore_Click"
                Content="加载更多"
                FontSize="12"
                Visibility="Collapsed" />
        </Grid>

        <!-- 题单内容 -->
        <Grid x:Name="TrainingDetailPanel" Visibility="Collapsed" AutomationProperties.AutomationId="PracticeTrainingDetailPanel">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="TrainingDetailTransform" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid
                Grid.Row="0"
                Padding="24,14,24,10"
                MaxWidth="720"
                HorizontalAlignment="Center"
                ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="0"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="8"
                    Click="TrainingDetailBack_Click">
                    <FontIcon Glyph="&#xE72B;" FontSize="15" />
                </Button>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock
                        x:Name="TrainingProblemTitle"
                        FontSize="15"
                        FontWeight="SemiBold"
                        MaxLines="1"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="TrainingProblemMeta"
                        FontSize="11"
                        Opacity="0.55" />
                </StackPanel>
                <ProgressRing
                    x:Name="TrainingProblemRing"
                    Grid.Column="2"
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center"
                    IsActive="False"
                    Visibility="Collapsed" />
            </Grid>
            <TextBox
                x:Name="TrainingProblemSearchBox"
                Grid.Row="1"
                Width="720"
                Margin="0,0,0,4"
                Padding="14,9,14,9"
                HorizontalAlignment="Center"
                CornerRadius="10"
                FontSize="13"
                PlaceholderText="搜索题目"
                TextChanged="TrainingProblemSearch_TextChanged" />
            <ListView
                x:Name="TrainingProblemList"
                Grid.Row="2"
                Width="720"
                MaxWidth="720"
                Margin="0,0,0,20"
                HorizontalAlignment="Center"
                CornerRadius="10"
                IsItemClickEnabled="True"
                ItemClick="TrainingProblemList_ItemClick"
                ItemTemplate="{StaticResource TrainingProblemTemplate}"
                SelectionMode="None" />
            <TextBlock
                x:Name="TrainingProblemEmptyText"
                Grid.Row="2"
                Margin="0,40,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                FontSize="13"
                Opacity="0.55"
                Text="没有匹配的题目"
                Visibility="Collapsed" />
        </Grid>

        <!-- 题目详情 -->
        <Grid x:Name="ProblemPanel" Visibility="Collapsed" AutomationProperties.AutomationId="PracticeProblemPanel">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="ProblemTransform" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="10" Padding="20,12,20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="0"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="8"
                    Click="BackToResults_Click"
                    ToolTipService.ToolTip="返回搜索结果">
                    <FontIcon Glyph="&#xE72B;" FontSize="15" />
                </Button>
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center">
                    <Image x:Name="ProblemOjIcon" Width="18" Height="18" Opacity="0.85" />
                    <TextBlock x:Name="ProblemOjText" FontSize="11" Opacity="0.7" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="0" VerticalAlignment="Center">
                    <TextBlock
                        x:Name="ProblemTitleText"
                        FontSize="15"
                        FontWeight="SemiBold"
                        TextTrimming="CharacterEllipsis"
                        MaxLines="1" />
                    <TextBlock
                        x:Name="ProblemStatusText"
                        FontSize="11"
                        Opacity="0.55"
                        Text="正在抓取题面…"
                        TextTrimming="CharacterEllipsis"
                        MaxLines="1" />
                </StackPanel>
                <Button
                    x:Name="TranslateButton"
                    Grid.Column="3"
                    Height="30"
                    Padding="12,0"
                    CornerRadius="8"
                    FontSize="12"
                    Content="翻译"
                    Visibility="Collapsed"
                    Click="TranslateButton_Click" />
                <Button
                    x:Name="LoginButton"
                    Grid.Column="4"
                    Height="30"
                    Padding="12,0"
                    CornerRadius="8"
                    FontSize="12"
                    Content="登录"
                    Click="LoginButton_Click" />
                <Button
                    Grid.Column="5"
                    Height="30"
                    Padding="12,0"
                    CornerRadius="8"
                    FontSize="12"
                    Content="打开原题"
                    Click="OpenOriginal_Click" />
            </Grid>

            <Grid Grid.Row="1" Margin="16,0,16,16" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左：题面（Markdown + LaTeX） -->
                <Border
                    Grid.Column="0"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <WebView2 x:Name="ProblemWebView" />
                </Border>

                <!-- 右：草稿编辑器 + 操作 -->
                <Grid Grid.Column="1" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            x:Name="LanguageCombo"
                            Grid.Column="0"
                            Height="30"
                            MinWidth="120"
                            FontSize="12"
                            CornerRadius="8"
                            SelectionChanged="LanguageCombo_SelectionChanged">
                            <ComboBoxItem Content="C++17" Tag="cpp" IsSelected="True" />
                        </ComboBox>
                    </Grid>

                    <Border
                        Grid.Row="1"
                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <WebView2 x:Name="PracticeEditorWebView" />
                    </Border>

                    <!-- 底部操作栏 -->
                    <StackPanel
                        Grid.Row="2"
                        Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Right">
                        <Button
                            Height="32"
                            Padding="16,0"
                            CornerRadius="8"
                            FontSize="12"
                            Content="重置草稿"
                            Click="ResetDraft_Click" />
                        <Button
                            Height="32"
                            Padding="16,0"
                            CornerRadius="8"
                            FontSize="12"
                            Content="提交"
                            Click="Submit_Click"
                            AutomationProperties.AutomationId="PracticeSubmitButton" />
                        <Button
                            Height="32"
                            Padding="16,0"
                            CornerRadius="8"
                            FontSize="12"
                            Content="测试"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="TestSample_Click"
                            AutomationProperties.AutomationId="PracticeTestButton" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- 测试浮层 -->
        <Grid
            x:Name="TestOverlay"
            Background="#66000000"
            Visibility="Collapsed"
            AutomationProperties.AutomationId="PracticeTestOverlay">
            <Border
                Width="760"
                MaxHeight="660"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 标题 -->
                    <Grid Padding="20,16,12,10" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock
                                x:Name="TestTitleText"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Text="测试" />
                            <TextBlock
                                x:Name="TestSubtitleText"
                                FontSize="11"
                                Opacity="0.55" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            Width="30"
                            Height="30"
                            Padding="0"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="8"
                            Click="CloseTest_Click">
                            <FontIcon FontSize="12" Glyph="&#xE711;" />
                        </Button>
                    </Grid>

                    <!-- 选择样例 / 手动输入 -->
                    <Grid
                        x:Name="TestSetupPanel"
                        Grid.Row="1"
                        Padding="20,0,20,8"
                        RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <RadioButton
                                x:Name="TestSampleMode"
                                Content="样例"
                                IsChecked="True"
                                Checked="TestMode_Checked" />
                            <RadioButton
                                x:Name="TestManualMode"
                                Content="手动输入"
                                Checked="TestMode_Checked" />
                        </StackPanel>

                        <Grid x:Name="TestSampleSection" Grid.Row="1" RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Opacity="0.55"
                                    Text="选择要运行的样例" />
                                <HyperlinkButton
                                    Grid.Column="1"
                                    Padding="6,2"
                                    FontSize="12"
                                    Content="全选"
                                    Click="TestSelectAll_Click" />
                                <HyperlinkButton
                                    Grid.Column="2"
                                    Padding="6,2"
                                    FontSize="12"
                                    Content="全不选"
                                    Click="TestSelectNone_Click" />
                            </Grid>
                            <ListView
                                x:Name="TestSampleList"
                                Grid.Row="1"
                                MaxHeight="300"
                                ItemTemplate="{StaticResource TestSampleItemTemplate}"
                                SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="MinHeight" Value="0" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,6" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                            </ListView>
                        </Grid>

                        <StackPanel
                            x:Name="TestManualSection"
                            Grid.Row="1"
                            Spacing="6"
                            Visibility="Collapsed">
                            <TextBlock FontSize="11" Opacity="0.55" Text="标准输入" />
                            <TextBox
                                x:Name="TestManualInput"
                                Height="230"
                                AcceptsReturn="True"
                                FontFamily="Cascadia Mono, Consolas, monospace"
                                FontSize="12"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock
                            x:Name="TestHintText"
                            Grid.Row="2"
                            FontSize="11"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                    </Grid>

                    <!-- 结果 -->
                    <Grid
                        x:Name="TestResultPanel"
                        Grid.Row="1"
                        Padding="20,0,20,8"
                        RowSpacing="8"
                        Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border
                            x:Name="TestCompileErrorBox"
                            Padding="10,8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="TestCompileError"
                                FontFamily="Cascadia Mono, Consolas, monospace"
                                FontSize="11"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                IsTextSelectionEnabled="True"
                                TextWrapping="Wrap" />
                        </Border>
                        <ListView
                            x:Name="TestResultList"
                            Grid.Row="1"
                            MaxHeight="440"
                            ItemTemplate="{StaticResource TestResultTemplate}"
                            SelectionMode="None" />
                    </Grid>

                    <!-- 底部按钮 -->
                    <Grid Grid.Row="2" Padding="20,12,20,16" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressRing
                            x:Name="TestRunRing"
                            Width="16"
                            Height="16"
                            VerticalAlignment="Center"
                            IsActive="False"
                            Visibility="Collapsed" />
                        <Button
                            x:Name="TestBackButton"
                            Grid.Column="2"
                            Height="32"
                            Padding="16,0"
                            CornerRadius="8"
                            FontSize="12"
                            Content="重新选择"
                            Click="TestBack_Click"
                            Visibility="Collapsed" />
                        <Button
                            x:Name="TestCloseButton"
                            Grid.Column="3"
                            Height="32"
                            Padding="16,0"
                            CornerRadius="8"
                            FontSize="12"
                            Content="关闭"
                            Click="CloseTest_Click"
                            Visibility="Collapsed" />
                        <Button
                            x:Name="RunTestButton"
                            Grid.Column="4"
                            Height="32"
                            Padding="20,0"
                            CornerRadius="8"
                            FontSize="12"
                            Content="运行测试"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="RunTests_Click"
                            AutomationProperties.AutomationId="PracticeRunTestButton" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 登录浮层：圆角 WebView2 -->
        <Grid
            x:Name="LoginOverlay"
            Background="#99000000"
            Visibility="Collapsed"
            AutomationProperties.AutomationId="PracticeLoginOverlay">
            <Border
                x:Name="LoginBorder"
                Margin="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Padding="16,10" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="1">
                            <TextBlock x:Name="LoginTitleText" Text="登录" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock
                                x:Name="LoginHintText"
                                Text=""
                                FontSize="11"
                                Opacity="0.55" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <ProgressRing
                                x:Name="LoginRing"
                                Width="16"
                                Height="16"
                                IsActive="False"
                                Visibility="Collapsed" />
                            <Button
                                Width="30"
                                Height="30"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="8"
                                Click="CloseLogin_Click"
                                ToolTipService.ToolTip="关闭"
                                AutomationProperties.AutomationId="PracticeLoginCloseButton">
                                <FontIcon Glyph="&#xE711;" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Border
                        Grid.Row="1"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,12,12"
                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                        <Grid>
                            <!-- 底部留出圆角背景：WebView2 的原生画面不会被父级圆角裁切 -->
                            <WebView2 x:Name="LoginWebView" Margin="0,0,0,10" />
                            <!-- 加载占位：页面加载完成前遮住 WebView 白屏，加载后再显示内容 -->
                            <Grid x:Name="LoginLoadingPanel" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                    <ProgressRing Width="36" Height="36" IsActive="True" />
                                    <TextBlock Text="页面加载中…" FontSize="13" Opacity="0.6" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 验证码浮层：把触发了验证码的页面交给用户手动完成 -->
        <Grid
            x:Name="CaptchaOverlay"
            Background="#99000000"
            Visibility="Collapsed"
            AutomationProperties.AutomationId="PracticeCaptchaOverlay">
            <Border
                Width="900"
                Height="640"
                MaxWidth="1000"
                MaxHeight="720"
                Margin="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Padding="16,10" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="1">
                            <TextBlock Text="需要验证" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock
                                Text="洛谷要求人机验证，请在下方完成后点击「我已完成」，搜索会自动继续。"
                                FontSize="11"
                                Opacity="0.55" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button
                                Content="我已完成"
                                Height="30"
                                Padding="12,0"
                                CornerRadius="8"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="CaptchaDone_Click"
                                AutomationProperties.AutomationId="PracticeCaptchaDoneButton" />
                            <Button
                                Width="30"
                                Height="30"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="8"
                                Click="CaptchaCancel_Click"
                                ToolTipService.ToolTip="跳过">
                                <FontIcon Glyph="&#xE711;" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Border
                        Grid.Row="1"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,12,12">
                        <WebView2 x:Name="CaptchaWebView" Margin="0,0,0,10" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 搜索加载浮层：微软商店风格，居中的大进度环 -->
        <Grid x:Name="SearchLoadingOverlay" Visibility="Collapsed" Background="Transparent">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16">
                <ProgressRing
                    x:Name="SearchLoadingRing"
                    Width="56"
                    Height="56"
                    IsActive="True"
                    Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                <TextBlock
                    x:Name="SearchLoadingText"
                    FontSize="13"
                    Opacity="0.7"
                    HorizontalAlignment="Center"
                    Text="正在搜索…" />
                <Button
                    Content="取消"
                    Height="30"
                    Padding="16,0"
                    CornerRadius="8"
                    FontSize="12"
                    HorizontalAlignment="Center"
                    Click="CancelSearch_Click" />
            </StackPanel>
        </Grid>

        <!-- 后台抓取用的隐藏浏览器：桌面尺寸但挪到可视区外，保证站点按 PC 端布局渲染
             （2px 视口会让部分站点切到移动端布局，抓不到想要的节点） -->
        <Grid
            Width="1280"
            Height="800"
            Margin="-4000,-4000,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsHitTestVisible="False">
            <WebView2 x:Name="FetchWebView" />
        </Grid>
    </Grid>
</UserControl>
