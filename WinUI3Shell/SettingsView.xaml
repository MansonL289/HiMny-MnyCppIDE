﻿<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinUI3Shell.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- 分组卡片：只负责圆角、描边和背景，内边距交给行控制 -->
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!-- 卡片头部标题 -->
        <Style x:Key="SettingsCardHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="16,12,16,4" />
        </Style>

        <!-- 行式设置项：图标 + 标题/说明 + 右侧控件 -->
        <Style x:Key="SettingRowStyle" TargetType="Grid">
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="Padding" Value="16,8,12,8" />
            <Setter Property="ColumnSpacing" Value="12" />
        </Style>

        <!-- 行左侧图标 -->
        <Style x:Key="SettingIconStyle" TargetType="FontIcon">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Width" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>

        <!-- 行与行之间的 1px 分隔线 -->
        <Style x:Key="SettingDividerStyle" TargetType="Rectangle">
            <Setter Property="Height" Value="1" />
            <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="Margin" Value="16,0,12,0" />
        </Style>

        <!-- 设置项次要说明文字 -->
        <Style x:Key="SettingDescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>

        <!-- 代码输入框：等宽字体 + 圆角描边，模仿 Monaco 代码块的观感 -->
        <Style x:Key="CodeTextBoxStyle" TargetType="TextBox">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, 'Microsoft YaHei UI', monospace" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CornerRadius" Value="8" />
            <!-- 四边一致的细描边，避免默认模板那种“只有底部一条亮线”的方角观感 -->
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MinHeight" Value="120" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <!-- 设置项左侧标题 -->
        <Style x:Key="SettingLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <!-- 设置项右侧控件统一尺寸，外观对齐 Windows 11 设置页的下拉框 -->
        <Style x:Key="SettingComboStyle" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
            <Setter Property="MinWidth" Value="200" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,0,8,0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style x:Key="SettingNumberStyle" TargetType="NumberBox">
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="SpinButtonPlacementMode" Value="Compact" />
            <Setter Property="SmallChange" Value="1" />
        </Style>

        <Style x:Key="SettingSwitchStyle" TargetType="ToggleSwitch">
            <!-- 默认样式的 MinWidth 为容纳“开/关”文字预留了 154px，会让开关本身离右边缘很远；
                 轨道本身加上内边距约 48px，宽度小于它会把胶囊右侧裁掉 -->
            <Setter Property="MinWidth" Value="0" />
            <!-- 默认 MinHeight=32 会把控件撑得比胶囊(20)高，胶囊在内部垂直居中，
                 与同一行文字相比就会往下掉一截 -->
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Width" Value="48" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="OffContent" Value="" />
            <Setter Property="OnContent" Value="" />
        </Style>
    </UserControl.Resources>

    <!-- 标题与退出按钮复用主窗口标题栏，这里只保留导航和设置内容 -->
    <Grid Background="Transparent" KeyDown="Root_KeyDown">
        <NavigationView
            x:Name="NavView"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneToggleButtonVisible="False"
            PaneDisplayMode="Left"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="GeneralNavItem" Content="通用" Tag="general" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="EditorNavItem" Content="编辑器" Tag="editor">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE70F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="CompileNavItem" Content="编译选项" Tag="compile">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="TemplateNavItem" Content="新文件模板" Tag="template">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="PracticeNavItem" Content="刷题模式" Tag="practice">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7C3;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="AboutNavItem" Content="关于" Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid MaxWidth="1100">
                <!-- ===== 通用 ===== -->
                <ScrollViewer x:Name="GeneralPane" Padding="16" VerticalScrollBarVisibility="Auto">
                    <!-- 页面切换：淡入 + 横向滑动，用 WinUI 3 的隐式过渡 -->
                    <ScrollViewer.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.18" />
                    </ScrollViewer.OpacityTransition>
                    <ScrollViewer.TranslationTransition>
                        <Vector3Transition Duration="0:0:0.18" />
                    </ScrollViewer.TranslationTransition>
                    <StackPanel>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="外观" Style="{StaticResource SettingsCardHeaderStyle}" />

                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE790;" Style="{StaticResource SettingIconStyle}" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="应用主题" Style="{StaticResource SettingLabelStyle}" />
                                        <TextBlock Text="选择界面跟随系统还是固定明暗" Style="{StaticResource SettingDescriptionStyle}" />
                                    </StackPanel>
                                    <ComboBox
                                        Grid.Column="2"
                                        x:Name="AppThemeBox"
                                        Style="{StaticResource SettingComboStyle}"
                                        SelectionChanged="AppThemeBox_SelectionChanged">
                                        <ComboBoxItem Content="跟随系统" />
                                        <ComboBoxItem Content="浅色" />
                                        <ComboBoxItem Content="深色" />
                                    </ComboBox>
                                </Grid>

                                <Rectangle Style="{StaticResource SettingDividerStyle}" />

                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE771;" Style="{StaticResource SettingIconStyle}" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="编辑器主题" Style="{StaticResource SettingLabelStyle}" />
                                        <TextBlock Text="代码区域的配色，可与界面主题不同" Style="{StaticResource SettingDescriptionStyle}" />
                                    </StackPanel>
                                    <ComboBox
                                        Grid.Column="2"
                                        x:Name="EditorThemeBox"
                                        Style="{StaticResource SettingComboStyle}"
                                        SelectionChanged="EditorThemeBox_SelectionChanged">
                                        <ComboBoxItem Content="跟随系统" />
                                        <ComboBoxItem Content="深色" />
                                        <ComboBoxItem Content="浅色" />
                                    </ComboBox>
                                </Grid>

                                <Rectangle Style="{StaticResource SettingDividerStyle}" />

                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE8A3;" Style="{StaticResource SettingIconStyle}" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="界面缩放" Style="{StaticResource SettingLabelStyle}" />
                                        <TextBlock Text="整体放大或缩小界面文字与控件" Style="{StaticResource SettingDescriptionStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <!-- 上下限在代码里赋值：XAML 解析时先设 Minimum 会直接抛异常 -->
                                        <Slider
                                            x:Name="UiZoomSlider"
                                            Width="200"
                                            StepFrequency="5"
                                            SnapsTo="Ticks"
                                            ValueChanged="UiZoomSlider_ValueChanged" />
                                        <TextBlock
                                            x:Name="UiZoomValueText"
                                            Width="52"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SettingLabelStyle}"
                                            Text="100%" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="文件" Style="{StaticResource SettingsCardHeaderStyle}" />

                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE74E;" Style="{StaticResource SettingIconStyle}" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="自动保存" Style="{StaticResource SettingLabelStyle}" />
                                        <TextBlock Text="内容变动后自动写入磁盘" Style="{StaticResource SettingDescriptionStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        Grid.Column="2"
                                        x:Name="AutoSaveSwitch"
                                        Style="{StaticResource SettingSwitchStyle}"
                                        Toggled="AutoSaveSwitch_Toggled" />
                                </Grid>

                                <Rectangle Style="{StaticResource SettingDividerStyle}" />

                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE823;" Style="{StaticResource SettingIconStyle}" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="自动保存间隔" Style="{StaticResource SettingLabelStyle}" />
                                        <TextBlock Text="两次自动保存之间的等待时间" Style="{StaticResource SettingDescriptionStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <NumberBox
                                            x:Name="AutoSaveSecondsBox"
                                            Style="{StaticResource SettingNumberStyle}"
                                            ValueChanged="AutoSaveSecondsBox_ValueChanged" />
                                        <TextBlock Text="秒" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>

                                <Rectangle Style="{StaticResource SettingDividerStyle}" />

                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE8D2;" Style="{StaticResource SettingIconStyle}" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="保存编码" Style="{StaticResource SettingLabelStyle}" />
                                        <TextBlock Text="写入文件时使用的字符编码" Style="{StaticResource SettingDescriptionStyle}" />
                                    </StackPanel>
                                    <ComboBox
                                        Grid.Column="2"
                                        x:Name="SaveEncodingBox"
                                        Style="{StaticResource SettingComboStyle}"
                                        SelectionChanged="SaveEncodingBox_SelectionChanged">
                                        <ComboBoxItem Content="UTF-8" />
                                        <ComboBoxItem Content="UTF-8 (BOM)" />
                                        <ComboBoxItem Content="GBK" />
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="终端" Style="{StaticResource SettingsCardHeaderStyle}" />

                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE768;" Style="{StaticResource SettingIconStyle}" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="运行结束后暂停" Style="{StaticResource SettingLabelStyle}" />
                                        <TextBlock Text="程序退出后保留窗口，便于查看输出" Style="{StaticResource SettingDescriptionStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        Grid.Column="2"
                                        x:Name="PauseOnExitSwitch"
                                        Style="{StaticResource SettingSwitchStyle}"
                                        Toggled="PauseOnExitSwitch_Toggled" />
                                </Grid>

                                <Rectangle Style="{StaticResource SettingDividerStyle}" />

                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE756;" Style="{StaticResource SettingIconStyle}" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="终端工作目录" Style="{StaticResource SettingLabelStyle}" />
                                        <TextBlock Text="运行程序时终端使用的起始目录" Style="{StaticResource SettingDescriptionStyle}" />
                                    </StackPanel>
                                    <ComboBox
                                        Grid.Column="2"
                                        x:Name="TerminalDirectoryBox"
                                        Style="{StaticResource SettingComboStyle}"
                                        SelectionChanged="TerminalDirectoryBox_SelectionChanged">
                                        <ComboBoxItem Content="当前项目目录" />
                                        <ComboBoxItem Content="程序所在目录" />
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== 编辑器 ===== -->
                <ScrollViewer
                    x:Name="EditorPane"
                    Padding="16"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="Collapsed">
                    <ScrollViewer.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.18" />
                    </ScrollViewer.OpacityTransition>
                    <ScrollViewer.TranslationTransition>
                        <Vector3Transition Duration="0:0:0.18" />
                    </ScrollViewer.TranslationTransition>
                    <StackPanel>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="文字" Style="{StaticResource SettingsCardHeaderStyle}" />

                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE8D2;" Style="{StaticResource SettingIconStyle}" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="字体" Style="{StaticResource SettingLabelStyle}" />
                                        <TextBlock Text="代码使用的显示字体，可直接输入字体名" Style="{StaticResource SettingDescriptionStyle}" />
                                    </StackPanel>
                                    <ComboBox
                                        Grid.Column="2"
                                        x:Name="FontFamilyBox"
                                        Style="{StaticResource SettingComboStyle}"
                                        IsEditable="True"
                                        MinWidth="240"
                                        HorizontalContentAlignment="Left"
                                        SelectionChanged="FontFamilyBox_SelectionChanged"
                                        LostFocus="FontFamilyBox_LostFocus">
                                        <ComboBoxItem Content="Cascadia Mono, Consolas, &quot;Microsoft YaHei UI&quot;, monospace" />
                                        <ComboBoxItem Content="Consolas, &quot;Microsoft YaHei UI&quot;, monospace" />
                                        <ComboBoxItem Content="&quot;Microsoft YaHei UI&quot;, monospace" />
                                        <ComboBoxItem Content="JetBrains Mono, Consolas, monospace" />
                                        <ComboBoxItem Content="Fira Code, Consolas, monospace" />
                                        <ComboBoxItem Content="Courier New, monospace" />
                                    </ComboBox>
                                </Grid>

                                <Rectangle Style="{StaticResource SettingDividerStyle}" />

                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE8E9;" Style="{StaticResource SettingIconStyle}" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="字号" Style="{StaticResource SettingLabelStyle}" />
                                        <TextBlock Text="代码文字的大小" Style="{StaticResource SettingDescriptionStyle}" />
                                    </StackPanel>
                                    <NumberBox
                                        Grid.Column="2"
                                        x:Name="FontSizeBox"
                                        Style="{StaticResource SettingNumberStyle}"
                                        ValueChanged="FontSizeBox_ValueChanged" />
                                </Grid>

                                <Rectangle Style="{StaticResource SettingDividerStyle}" />

                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE8D2;" Style="{StaticResource SettingIconStyle}" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="字体连字" Style="{StaticResource SettingLabelStyle}" />
                                        <TextBlock Text="启用 Fira Code 等字体的连字效果" Style="{StaticResource SettingDescriptionStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        Grid.Column="2"
                                        x:Name="FontLigaturesSwitch"
                                        Style="{StaticResource SettingSwitchStyle}"
                                        Toggled="FontLigaturesSwitch_Toggled" />
                                </Grid>

                                <Rectangle Style="{StaticResource SettingDividerStyle}" />

                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE8FD;" Style="{StaticResource SettingIconStyle}" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="缩进方式" Style="{StaticResource SettingLabelStyle}" />
                                        <TextBlock Text="按 Tab 时插入空格还是制表符" Style="{StaticResource SettingDescriptionStyle}" />
                                    </StackPanel>
                                    <ComboBox
                                        Grid.Column="2"
                                        x:Name="IndentBox"
                                        Style="{StaticResource SettingComboStyle}"
                                        SelectionChanged="IndentBox_SelectionChanged">
                                        <ComboBoxItem Content="空格" />
                                        <ComboBoxItem Content="制表符" />
                                    </ComboBox>
                                </Grid>

                                <Rectangle Style="{StaticResource SettingDividerStyle}" />

                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE8FD;" Style="{StaticResource SettingIconStyle}" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="缩进宽度" Style="{StaticResource SettingLabelStyle}" />
                                        <TextBlock Text="一个缩进层级对应的字符宽度" Style="{StaticResource SettingDescriptionStyle}" />
                                    </StackPanel>
                                    <NumberBox
                                        Grid.Column="2"
                                        x:Name="TabSizeBox"
                                        Style="{StaticResource SettingNumberStyle}"
                                        ValueChanged="TabSizeBox_ValueChanged" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="显示" Style="{StaticResource SettingsCardHeaderStyle}" />

                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE8A9;" Style="{StaticResource SettingIconStyle}" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="自动换行" Style="{StaticResource SettingLabelStyle}" />
                                        <TextBlock Text="长行超出视口时如何折行" Style="{StaticResource SettingDescriptionStyle}" />
                                    </StackPanel>
                                    <ComboBox
                                        Grid.Column="2"
                                        x:Name="WordWrapBox"
                                        Style="{StaticResource SettingComboStyle}"
                                        SelectionChanged="WordWrapBox_SelectionChanged">
                                        <ComboBoxItem Content="不换行" />
                                        <ComboBoxItem Content="按视口宽度" />
                                        <ComboBoxItem Content="按单词换行" />
                                    </ComboBox>
                                </Grid>

                                <Rectangle Style="{StaticResource SettingDividerStyle}" />

                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE8A1;" Style="{StaticResource SettingIconStyle}" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="迷你地图" Style="{StaticResource SettingLabelStyle}" />
                                        <TextBlock Text="在编辑器右侧显示代码缩略图" Style="{StaticResource SettingDescriptionStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        Grid.Column="2"
                                        x:Name="MinimapSwitch"
                                        Style="{StaticResource SettingSwitchStyle}"
                                        Toggled="MinimapSwitch_Toggled" />
                                </Grid>

                                <Rectangle Style="{StaticResource SettingDividerStyle}" />

                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE7C3;" Style="{StaticResource SettingIconStyle}" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="空白字符" Style="{StaticResource SettingLabelStyle}" />
                                        <TextBlock Text="空格与制表符等不可见字符的显示方式" Style="{StaticResource SettingDescriptionStyle}" />
                                    </StackPanel>
                                    <ComboBox
                                        Grid.Column="2"
                                        x:Name="WhitespaceBox"
                                        Style="{StaticResource SettingComboStyle}"
                                        SelectionChanged="WhitespaceBox_SelectionChanged">
                                        <ComboBoxItem Content="不显示" />
                                        <ComboBoxItem Content="仅边界" />
                                        <ComboBoxItem Content="仅选中" />
                                        <ComboBoxItem Content="行尾" />
