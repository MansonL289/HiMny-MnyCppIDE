                                        NavigateUri="https://github.com/MansonL289/HiMny-MnyCppIDE/issues" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCardStyle}">
                            <StackPanel>
                                <TextBlock Text="更新最新版" Style="{StaticResource SettingsCardHeaderStyle}" />

                                <Grid Style="{StaticResource SettingRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE895;" Style="{StaticResource SettingIconStyle}" />
                                    <HyperlinkButton
                                        Grid.Column="1"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        Content="https://github.com/MansonL289/HiMny-MnyCppIDE/tags"
                                        NavigateUri="https://github.com/MansonL289/HiMny-MnyCppIDE/tags" />
                                </Grid>

                                <Rectangle Style="{StaticResource SettingDividerStyle}" />

                                <StackPanel Padding="16,8,16,16" Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Button x:Name="CheckUpdateButton" Click="CheckUpdate_Click" Content="检查更新" />
                                        <ProgressRing
                                            x:Name="CheckRing"
                                            Width="20"
                                            Height="20"
                                            VerticalAlignment="Center"
                                            Visibility="Collapsed" />
                                    </StackPanel>
                                    <TextBlock
                                        x:Name="UpdateText"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</UserControl>
