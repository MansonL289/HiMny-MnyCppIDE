<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinUI3Shell.DebugWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        Padding="10,8,10,10"
        RowSpacing="4"
        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
        AutomationProperties.AutomationId="DebugControlRoot">
        <Grid.KeyboardAccelerators>
            <!-- 焦点在调试窗口时也能用调试快捷键 -->
            <KeyboardAccelerator Key="F5" Invoked="Shortcut_Invoked" />
            <KeyboardAccelerator Key="F5" Modifiers="Shift" Invoked="Shortcut_Invoked" />
            <KeyboardAccelerator Key="F7" Invoked="Shortcut_Invoked" />
            <KeyboardAccelerator Key="F8" Invoked="Shortcut_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6">
            <Button Padding="10,3" FontSize="12" Content="开始" ToolTipService.ToolTip="开始/继续调试 (F5)" Click="StartButton_Click" />
            <Button Padding="10,3" FontSize="12" Content="停止" ToolTipService.ToolTip="停止调试 (Shift+F5)" Click="StopButton_Click" />
            <Button Padding="10,3" FontSize="12" Content="跳过" ToolTipService.ToolTip="单步跳过 (F7)" Click="StepOverButton_Click" />
            <Button Padding="10,3" FontSize="12" Content="进入" ToolTipService.ToolTip="单步进入 (F8)" Click="StepIntoButton_Click" />
            <Button Padding="10,3" FontSize="12" Content="跳出" ToolTipService.ToolTip="单步跳出" Click="StepOutButton_Click" />
        </StackPanel>

        <TextBlock
            x:Name="StatusText"
            Grid.Row="1"
            FontSize="11"
            Opacity="0.7"
            Text="未启动"
            TextWrapping="Wrap" />

        <TextBlock
            Grid.Row="2"
            Margin="0,4,0,2"
            FontSize="11"
            FontWeight="SemiBold"
            Opacity="0.8"
            Text="局部变量" />

        <ListView x:Name="LocalsList" Grid.Row="3" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,1,0,1" ColumnDefinitions="Auto,*">
                        <TextBlock
                            Grid.Column="0"
                            FontSize="12"
                            FontFamily="Cascadia Mono, Consolas, monospace"
                            Text="{Binding Name}"
                            TextTrimming="CharacterEllipsis"
                            MaxWidth="140" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            FontSize="12"
                            FontFamily="Cascadia Mono, Consolas, monospace"
                            Opacity="0.75"
                            Text="{Binding Value}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            Grid.Row="4"
            Margin="0,6,0,2"
            FontSize="11"
            FontWeight="SemiBold"
            Opacity="0.8"
            Text="调用栈" />

        <ListView
            x:Name="StackList"
            Grid.Row="5"
            IsItemClickEnabled="True"
            ItemClick="StackList_ItemClick"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock
                        FontSize="12"
                        FontFamily="Cascadia Mono, Consolas, monospace"
                        Text="{Binding Text}"
                        TextTrimming="CharacterEllipsis" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
